# Rain sandbox credentials. Keep real values in .env.local or Vercel; never commit them.
RAIN_API_KEY=
RAIN_TEAM_ID=
RAIN_USER_ID=
RAIN_COLLATERAL_CONTRACT_ID=
RAIN_BASE_URL=https://api-dev.raincards.xyz/v1

# Real Rain sandbox card issuance. Keep off while developing; enable only after verifying
# the issued-card scope and collateral configuration in your Rain sandbox account.
RAIN_LIVE_ISSUANCE=false

# When a real scoped sandbox card is issued, exercise it with Rain's sandbox merchant
# lifecycle: authorize the exact PO amount, then settle it. This writes a real sandbox
# transaction id into the decision log. Leave false while developing to avoid test noise.
RAIN_SIMULATE_SETTLEMENT=false

# Optional exact Rain status used to retire cards. Leave blank until confirmed for your
# sandbox account; the app will not claim a remote retirement without a successful readback.
RAIN_CARD_INACTIVE_STATUS=

# The one destructive endpoint. /api/reset wipes live decisions, cards and any policy
# above v1. On a public URL that is a button any stranger can press mid-judging, so set
# this in production and the console will ask for it once. Left blank locally, reset stays
# open so development is unaffected.
DEMO_RESET_TOKEN=

# Storage. Unset locally is fine — the app falls back to an in-memory store and the
# seeded history still loads, so replay works. 🔴 It MUST be set on the deployed build:
# serverless memory does not survive a cold start, and the decision log is what replay
# reads. Any Postgres connection string works; Neon's free tier is what this was built on.
DATABASE_URL=

# The Monad rule-version anchor. Built and wired; it activates the moment both of these
# exist. Needs a testnet RPC URL and a key with testnet MON for gas.
MONAD_RPC_URL=
MONAD_PRIVATE_KEY=

# Optional. Adds an LLM-written seller remark on top of the negotiation stage's
# deterministic offers. If unset, everything still works, just with the plain notes
# already in lib/negotiation.ts. Get a free key at console.groq.com, takes ~2 minutes.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- Sandbox payment routes (treasury rail, separate from supplier checkout) ---------
#
# POST /api/rails/simulate triggers a transfer along a Rain sandbox payment route. This is
# NOT how a supplier gets paid — a purchase issues a scoped card. This is evidence of the
# wider Rain rails, and it is sandbox only: no real funds move.
#
# The route id is required and is never invented. Creating a route means naming a
# destination address that belongs to somebody, so this app will not make one up. Create a
# route yourself in the sandbox and paste its id here:
#
#   curl -X POST https://api-dev.raincards.xyz/v1/payment-routes \
#     -H "Api-Key: $RAIN_API_KEY" -H "Content-Type: application/json" \
#     -d '{"userId":"...","source":{"currency":"usd","rail":"ach"},
#          "destination":{"currency":"usdc","rail":"base",
#                         "address":{"type":"onchain","address":"0xYOUR_TESTNET_ADDRESS"}}}'
#
# Left blank, /api/rails/simulate reports itself as not configured and does nothing.
RAIN_PAYMENT_ROUTE_ID=
